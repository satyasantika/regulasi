# Contoh .env.production untuk docker-compose.prod.yml. Salin ke .env.production (TIDAK di-commit) lalu isi rahasia.
APP_NAME="Regulasi FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=regulasi
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_VERSION=1.1.0
APP_URL=https://supportfkip.unsil.ac.id/regulasi
ASSET_URL=https://supportfkip.unsil.ac.id/regulasi

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# MariaDB 10.11+ NATIVE di host (dijangkau container lewat host.docker.internal; compose tidak memuat database).
# DB dan pengguna dibuat pemilik server (STANDAR-TEKNIS §2.2); nama pengguna menunggu keputusan pemilik.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_regulasi
DB_USERNAME=app
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/regulasi
SESSION_COOKIE=regulasi_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
# IP reverse proxy depan supportfkip (pisahkan dengan koma). Jangan "*" di produksi.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=regulasi:

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

# SMTP kampus (G-04)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=regulasi-fkip@unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# Pencarian Profil Ringan: Laravel Scout driver database + FULLTEXT MariaDB + kamus istilah (tanpa Meilisearch).
SCOUT_DRIVER=database
SCOUT_PREFIX=regulasi_
# Panjang token minimum FULLTEXT HARUS sama dengan innodb_ft_min_token_size di MariaDB host. Bawaan MariaDB = 3
# (maka isi 3); isi 2 hanya setelah pemilik server menyetel variabel itu dan indeks dibangun ulang.
REGULASI_FT_MIN_TOKEN=3

# Ekstraksi teks PDF (poppler-utils di image)
PDFTOTEXT_BIN=/usr/bin/pdftotext
PDFINFO_BIN=/usr/bin/pdfinfo

# Alamat di kaki portal (perlu verifikasi FKIP)
REGULASI_ALAMAT="Jl. Siliwangi No. 24, Kota Tasikmalaya, Jawa Barat 46115"

# Super-admin awal (PenggunaAwalSeeder) — sandi wajib diisi; akun ditandai wajib ganti sandi dan wajib MFA saat masuk pertama.
REGULASI_SUPERADMIN_EMAIL=fkip@unsil.ac.id
REGULASI_SUPERADMIN_PASSWORD=
# MFA wajib bagi super-admin & admin-regulasi. Biarkan true di produksi (ADR 0002).
MFA_AKTIF=true
REGULASI_SEED_TERBITKAN_SEMUA=false

# Port host container web (reverse proxy depan meneruskan /regulasi/ ke sini)
WEB_PORT=8034
