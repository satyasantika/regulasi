APP_NAME="Regulasi FKIP Unsil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_VERSION=0.4.0
# Lokal: http://localhost:8034/regulasi (nginx lokal memotong awalan, meniru reverse proxy).
# Produksi: https://supportfkip.unsil.ac.id/regulasi
APP_URL=http://localhost:8034/regulasi
ASSET_URL=${APP_URL}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB native di host (bukan container), lihat docs/keputusan/0001. Isi DB_PASSWORD di .env lokal.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_regulasi
DB_USERNAME=app
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/regulasi
SESSION_COOKIE=regulasi_session
# Produksi: true
SESSION_SECURE_COOKIE=false
# Produksi: IP reverse proxy; lokal: *
TRUSTED_PROXIES=*
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=regulasi:

# Redis bersama (container "redis", jaringan code_laranet)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=regulasi_
REDIS_DB=44
REDIS_CACHE_DB=45
REDIS_QUEUE_DB=46
HORIZON_PREFIX=regulasi_horizon:

# Mailpit bersama (container "alias-mailpit", UI http://localhost:18018)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=alias-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=regulasi-fkip@unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# Pencarian: Meilisearch internal (tanpa port host). Kunci master hanya di .env, jangan dikirim ke browser.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://regulasi-meilisearch:7700
MEILISEARCH_KEY=

# Super-admin awal (PenggunaAwalSeeder). Isi di .env; wajib di produksi.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
